{
  "opencollection": "1.0.0",
  "info": {
    "name": "Edge Delta Access API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "Access",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "GET /v1/orgs/{org_id}/access",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/orgs/:org_id/access",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path",
                "description": "Org ID"
              },
              {
                "name": "include_external",
                "value": "",
                "type": "query",
                "description": "If set to true response includes external state information from auth0"
              },
              {
                "name": "membership_requests",
                "value": "",
                "type": "query",
                "description": "If set to true response includes only items with pending status (to be used in Membership Requests)"
              }
            ]
          },
          "docs": "Returns accesses for the given org."
        },
        {
          "info": {
            "name": "POST /v1/orgs/{org_id}/access",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v1/orgs/:org_id/access",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path",
                "description": "Org ID"
              }
            ]
          },
          "docs": "Creates access entry."
        },
        {
          "info": {
            "name": "PUT /v1/orgs/{org_id}/access/{access_id}",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/v1/orgs/:org_id/access/:access_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path",
                "description": "Org ID"
              },
              {
                "name": "access_id",
                "value": "",
                "type": "path",
                "description": "Access ID"
              }
            ]
          },
          "docs": "Update access for caller and given id."
        },
        {
          "info": {
            "name": "DELETE /v1/orgs/{org_id}/access/{access_id}",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v1/orgs/:org_id/access/:access_id",
            "params": [
              {
                "name": "org_id",
                "value": "",
                "type": "path",
                "description": "Org ID"
              },
              {
                "name": "access_id",
                "value": "",
                "type": "path",
                "description": "Access ID"
              }
            ]
          },
          "docs": "Delete access for caller and given id."
        }
      ]
    }
  ],
  "bundled": true
}